          {
            "path": "https://example.invalid/patch.yaml"
          }
        ]
      }
    },
    {
      "name": "remote-replacement-file",
      "kustomization": {
        "replacements": [
          {
            "path": "https://example.invalid/replacements.yaml"
          }
        ]
      }
