    {
      "name": "unsupported-helm-chart-build",
      "kustomization": {
        "helmCharts": [
          {
            "name": "remote"
          }
        ]
      }
    }
  ],
  "production_build_cases": [
    {
      "name": "defaulted-external-substitution-before-flux",
      "kustomization": {
        "apiVersion": "kustomize.config.k8s.io/v1beta1",
        "kind": "Kustomization",
        "resources": [
          "resource.json"
        ]
      },
      "resources": {
        "resource.json": {
          "apiVersion": "helm.toolkit.fluxcd.io/v2",
          "kind": "HelmRelease",
          "metadata": {
            "name": "external-default",
            "namespace": "apps"
          },
          "spec": {
            "chartRef": {
              "kind": "OCIRepository",
              "name": "chart"
            },
            "values": {
              "version": "${REL}",
              "token": "${TOKEN:=fallback}"
            }
          }
        }
      },
      "definition": {
        "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
        "kind": "Kustomization",
        "metadata": {
          "name": "fixture",
          "namespace": "flux-system"
        },
        "spec": {
          "path": "./",
          "sourceRef": {
            "kind": "GitRepository",
            "name": "home-kubernetes"
          },
          "postBuild": {
            "substitute": {
              "REL": "1.2.3"
            },
            "substituteFrom": [
              {
                "kind": "Secret",
                "name": "inputs"
              }
            ]
          }
        }
      }
    },
    {
      "name": "remote-replacement-before-flux",
      "kustomization": {
        "apiVersion": "kustomize.config.k8s.io/v1beta1",
        "kind": "Kustomization",
        "replacements": [
          {
            "path": "https://example.invalid/replacements.yaml"
          }
        ]
      },
      "definition": {
        "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
        "kind": "Kustomization",
        "metadata": {
          "name": "fixture",
          "namespace": "flux-system"
        },
        "spec": {
          "path": "./",
          "sourceRef": {
            "kind": "GitRepository",
            "name": "home-kubernetes"
          }
        }
      }
    }
  ],
