{
  "name": "render-preflight",
  "target_sha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "parent_sha": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
  "preflight_cases": [
    {
      "name": "literal-substitution",
      "resource": {
        "apiVersion": "v1",
        "kind": "ConfigMap",
        "metadata": {
          "name": "literal"
        },
        "data": {
          "version": "${REL}"
        }
      },
      "definition": {
        "spec": {
          "postBuild": {
            "substitute": {
              "REL": "1.2.3"
            }
          }
        }
      }
    },
    {
      "name": "external-substitution-with-literal",
      "resource": {
        "apiVersion": "v1",
        "kind": "ConfigMap",
        "metadata": {
          "name": "external"
        },
        "data": {
          "version": "${REL}",
          "token": "${TOKEN}"
        }
      },
      "definition": {
        "spec": {
          "postBuild": {
            "substitute": {
              "REL": "1.2.3"
            },
            "substituteFrom": [
              {
                "kind": "Secret",
                "name": "inputs"
              }
            ]
          }
        }
      }
    },
    {
      "name": "unused-external-substitution",
      "resource": {
        "apiVersion": "v1",
        "kind": "ConfigMap",
        "metadata": {
          "name": "unused"
        },
        "data": {
          "version": "fixed"
        }
      },
      "definition": {
        "spec": {
          "postBuild": {
            "substituteFrom": [
              {
                "kind": "ConfigMap",
                "name": "inputs"
              }
            ]
          }
        }
      }
    }
  ],
  "graph_cases": [
    {
      "name": "remote-github-resource",
      "kustomization": {
        "resources": [
          "github.com/fluxcd/flux2//manifests?ref=v2.8.5"
        ]
      }
    },
    {
      "name": "remote-url-patch",
      "kustomization": {
        "patches": [
          {
            "path": "https://example.invalid/patch.yaml"
          }
        ]
      }
    },
    {
      "name": "remote-git-component",
      "kustomization": {
        "components": [
          "git::https://example.invalid/component.git//base?ref=v1"
        ]
      }
    },
    {
      "name": "missing-local-resource",
      "kustomization": {
        "resources": [
          "missing.yaml"
        ]
      }
    },
    {
      "name": "unsupported-helm-chart-build",
      "kustomization": {
        "helmCharts": [
          {
            "name": "remote"
          }
        ]
      }
    }
  ],
  "preflight_expected": [
    {
      "name": "literal-substitution",
      "reason_code": "supported"
    },
    {
      "name": "external-substitution-with-literal",
      "reason_code": "unsupported-substitution"
    },
    {
      "name": "unused-external-substitution",
      "reason_code": "supported"
    },
    {
      "name": "remote-github-resource",
      "reason_code": "remote-build-dependency"
    },
    {
      "name": "remote-url-patch",
      "reason_code": "remote-build-dependency"
    },
    {
      "name": "remote-git-component",
      "reason_code": "remote-build-dependency"
    },
    {
      "name": "missing-local-resource",
      "reason_code": "render-unsupported"
    },
    {
      "name": "unsupported-helm-chart-build",
      "reason_code": "remote-build-dependency"
    }
  ]
}
