{
  "name": "render-preflight",
  "target_sha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "parent_sha": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
  "preflight_cases": [
    {
      "name": "literal-substitution",
      "resource": {
        "apiVersion": "v1",
        "kind": "ConfigMap",
        "metadata": {
          "name": "literal"
        },
        "data": {
          "version": "${REL}"
        }
      },
      "definition": {
        "spec": {
          "postBuild": {
            "substitute": {
              "REL": "1.2.3"
            }
          }
        }
      }
    },
    {
      "name": "external-substitution-with-literal",
      "resource": {
        "apiVersion": "v1",
        "kind": "ConfigMap",
        "metadata": {
          "name": "external"
        },
        "data": {
          "version": "${REL}",
          "token": "${TOKEN}"
        }
      },
      "definition": {
        "spec": {
          "postBuild": {
            "substitute": {
              "REL": "1.2.3"
            },
            "substituteFrom": [
              {
                "kind": "Secret",
                "name": "inputs"
              }
            ]
          }
        }
      }
    },
    {
      "name": "defaulted-external-substitution",
      "resource": {
        "apiVersion": "v1",
        "kind": "ConfigMap",
        "metadata": {
          "name": "defaulted-external"
        },
        "data": {
          "version": "${REL}",
          "token": "${TOKEN:=fallback}"
        }
      },
      "definition": {
        "spec": {
          "postBuild": {
            "substitute": {
              "REL": "1.2.3"
            },
            "substituteFrom": [
              {
                "kind": "Secret",
                "name": "inputs"
              }
            ]
          }
        }
      }
    },
    {
      "name": "unused-external-substitution",
      "resource": {
        "apiVersion": "v1",
        "kind": "ConfigMap",
        "metadata": {
          "name": "unused"
        },
        "data": {
          "version": "fixed"
        }
      },
      "definition": {
        "spec": {
          "postBuild": {
            "substituteFrom": [
              {
                "kind": "ConfigMap",
                "name": "inputs"
              }
            ]
          }
        }
      }
    }
  ],
  "graph_cases": [
    {
      "name": "remote-github-resource",
      "kustomization": {
        "resources": [
          "github.com/fluxcd/flux2//manifests?ref=v2.8.5"
        ]
      }
    },
    {
      "name": "remote-url-patch",
      "kustomization": {
